# Koneksi Supabase PostgreSQL (Transaction Pooler — port 6543, dipakai saat runtime aplikasi)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Koneksi Langsung Supabase (Session / Direct — port 5432, dipakai Prisma untuk db push & migrate)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Secret untuk Auth.js (NextAuth v5) — generate dengan: npx auth secret
AUTH_SECRET="ganti-dengan-random-secret-minimal-32-karakter"
AUTH_URL="http://localhost:3000"
